---
import { STATUS_LABEL, projectLinks, type Project } from "../lib/projects";

interface Props {
  project: Project;
  // Set when the project has a published page at /projects/<slug>.
  pageUrl?: string;
}

const { project: p, pageUrl } = Astro.props;

const links = projectLinks(p);
---

<article class="card">
  <header>
    <div class="badges">
      <span class={`status status-${p.status}`}>{STATUS_LABEL[p.status]}</span>
      {p.inProgress && <span class="badge">In progress</span>}
    </div>
    <h3>{pageUrl ? <a class="card-title" href={pageUrl}>{p.title}</a> : p.title}</h3>
    <p class="tagline">
      {p.tagline}
      {p.role && <span class="role"> · {p.role}</span>}
    </p>
  </header>

  <p class="summary">{p.summary}</p>

  <ul class="tags" aria-label="Technologies">
    {p.tags.map((t) => <li>{t}</li>)}
  </ul>

  <nav class="links" aria-label={`${p.title} links`}>
    {pageUrl && (
      <a href={pageUrl}>
        Project page <span aria-hidden="true">→</span>
      </a>
    )}
    {links.map((l) => (
      <a href={l.url} target="_blank" rel="noopener noreferrer">
        {l.label} <span aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
</article>
